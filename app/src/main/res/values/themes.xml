<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Zalo" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Default value. -->
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_medium</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="colorIcon">@color/black</item>
        <item name="colorIconTint">@color/white</item>
        <item name="backgroundHeader">@drawable/bg_header</item>
        <item name="backgroundComponentSearch">@color/white</item>
        <item name="backgroundButtonCreateNewAccount">@color/gray_200</item>
        <item name="backgroundButtonCreateNewAccountPressed">@color/gray_300</item>

        <item name="pncBackgroundHeader">@color/gray_50</item>
        <item name="pncBackground">@color/super_white</item>
        <item name="pncBackground_pressed">@color/blue_50</item>
        <item name="pncBorder">@color/gray_200</item>
        <item name="pncBorderSearch">@color/gray_400</item>
        <item name="backgroundCleanSearch">@color/black</item>
        <item name="colorIconCleanSearch">@color/super_white</item>
    </style>
</resources>