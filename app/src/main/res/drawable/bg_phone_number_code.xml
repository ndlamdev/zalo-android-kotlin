<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/borderPhoneNumberCode" />
                    <corners android:bottomLeftRadius="@dimen/xsmall" android:topLeftRadius="@dimen/xsmall" />
                </shape>
            </item>
            <item android:right="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/backgroundPhoneNumberCode" />
                    <corners android:bottomLeftRadius="@dimen/xsmall" android:topLeftRadius="@dimen/xsmall" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/borderPhoneNumberCodePressed" />
                    <corners android:bottomLeftRadius="@dimen/xsmall" android:topLeftRadius="@dimen/xsmall" />
                </shape>
            </item>
            <item android:right="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/backgroundPhoneNumberCodePressed" />
                    <corners android:bottomLeftRadius="@dimen/xsmall" android:topLeftRadius="@dimen/xsmall" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>