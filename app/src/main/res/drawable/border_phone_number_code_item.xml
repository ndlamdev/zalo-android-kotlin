<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/pncBackground_pressed" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="?attr/pncBorder" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape>
                    <solid android:color="?attr/pncBackground" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
