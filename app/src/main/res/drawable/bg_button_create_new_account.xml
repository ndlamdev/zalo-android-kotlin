<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape
            android:shape="rectangle">
            <solid android:color="?attr/backgroundButtonCreateNewAccountPressed" />
            <corners android:radius="@dimen/xxlarge" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape
            android:shape="rectangle">
            <solid android:color="?attr/backgroundButtonCreateNewAccount" />
            <corners android:radius="@dimen/xxlarge" />
        </shape>
    </item>
</selector>