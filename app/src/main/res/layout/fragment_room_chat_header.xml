<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/icon_size"
    android:background="?attr/backgroundHeader"
    android:orientation="horizontal"
    tools:context=".ui.roomchat.headers.RoomChatHeaderFragment">

    <ImageButton
        android:id="@+id/image_button_back"
        android:layout_width="@dimen/icon_size"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:contentDescription="@string/button_back_icon"
        android:scaleX="1.2"
        android:scaleY="1.2"
        android:src="@drawable/ic_white_arrow_left"
        android:stateListAnimator="@animator/button_opacity_animator" />

    <TextView
        android:id="@+id/text_room_chat_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:textSize="@dimen/text_xlarge"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <ImageButton
            android:id="@+id/image_button_call_audio"
            android:layout_width="@dimen/icon_size"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/button_back_icon"
            android:src="@drawable/ic_call"
            android:stateListAnimator="@animator/button_opacity_animator" />

        <ImageButton
            android:id="@+id/image_button_call_video"
            android:layout_width="@dimen/icon_size"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/button_back_icon"
            android:paddingHorizontal="@dimen/gap_item_in_linear_layout"
            android:scaleX="1.3"
            android:scaleY="1.3"
            android:src="@drawable/ic_video"
            android:stateListAnimator="@animator/button_opacity_animator" />

        <ImageButton
            android:id="@+id/image_button_menu"
            android:layout_width="@dimen/icon_size"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/button_back_icon"
            android:scaleX="1.3"
            android:scaleY="1.3"
            android:src="@drawable/ic_list"
            android:stateListAnimator="@animator/button_opacity_animator" />
    </LinearLayout>
</LinearLayout>