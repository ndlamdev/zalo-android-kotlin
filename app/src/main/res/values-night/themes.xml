<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Zalo" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Default value-->
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_medium</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black_900</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black_900</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="colorIcon">@color/white</item>
        <item name="colorIconTint">@color/white</item>
        <item name="backgroundHeader">@color/cardview_dark_background</item>
        <item name="backgroundComponentSearch">@color/black_700</item>
        <item name="backgroundButtonCreateNewAccount">@color/gray_700</item>
        <item name="backgroundButtonCreateNewAccountPressed">@color/gray_800</item>
        <item name="pncBackgroundHeader">@color/black_200</item>
        <item name="pncBackground">@color/black_700</item>
        <item name="pncBackground_pressed">@color/blue_800</item>
        <item name="pncBorder">@color/gray_800</item>
        <item name="pncBorderSearch">@color/gray_600</item>
        <item name="backgroundCleanSearch">@color/gray_300</item>
        <item name="colorIconCleanSearch">@color/black</item>

        <item name="backgroundPhoneNumberCode">@color/black_700</item>
        <item name="borderPhoneNumberCode">@color/gray_700</item>
        <item name="backgroundPhoneNumberCodePressed">#04182C</item>
        <item name="borderPhoneNumberCodePressed">#0B3B68</item>

        <item name="backgroundButtonContinueDisable">@color/gray_700</item>
        <item name="backgroundButtonContinueEnable">@color/blue_800</item>
    </style>
</resources>