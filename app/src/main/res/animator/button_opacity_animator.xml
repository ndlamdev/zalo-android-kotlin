<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator
            android:duration="250"
            android:propertyName="alpha"
            android:valueTo="0.5" />
    </item>
    <item>
        <objectAnimator
            android:duration="250"
            android:propertyName="alpha"
            android:valueFrom="0.5"
            android:valueTo="1" />
    </item>
</selector>